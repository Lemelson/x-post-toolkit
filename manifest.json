{
  "manifest_version": 3,
  "name": "X Video Toolkit — Download & Transcribe",
  "short_name": "X Video Toolkit",
  "version": "0.4.0",
  "description": "One-click X/Twitter and Google Drive video downloads with private local NVIDIA Parakeet v3 transcription.",
  "permissions": [
    "downloads",
    "tabs",
    "nativeMessaging",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://cdn.syndication.twimg.com/*",
    "https://video.twimg.com/*",
    "https://drive.google.com/*",
    "https://drive.usercontent.google.com/*",
    "https://*.googlevideo.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://drive.google.com/*"
      ],
      "js": [
        "content_x_adapter.js",
        "content_drive_adapter.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Video Toolkit",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
