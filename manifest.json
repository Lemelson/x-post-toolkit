{
  "manifest_version": 3,
  "name": "Video Toolkit",
  "version": "0.3.0",
  "description": "Download videos and generate local transcripts from X and Google Drive.",
  "permissions": [
    "downloads",
    "tabs",
    "nativeMessaging",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://cdn.syndication.twimg.com/*",
    "https://video.twimg.com/*",
    "https://drive.google.com/*",
    "https://drive.usercontent.google.com/*",
    "https://*.googlevideo.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://drive.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Video Toolkit",
    "default_popup": "popup.html"
  }
}
