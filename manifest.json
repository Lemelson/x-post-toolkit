{
  "manifest_version": 3,
  "name": "X Post Toolkit",
  "version": "0.2.0",
  "description": "Download X videos and generate local transcripts with one click.",
  "permissions": [
    "downloads",
    "tabs",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://cdn.syndication.twimg.com/*",
    "https://video.twimg.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "X Video Downloader",
    "default_popup": "popup.html"
  }
}
